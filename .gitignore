# Node.js
node_modules/
packages/*/dist/
coverage/

# Build artifacts
build/

# Python (legacy)
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (legacy)
venv/
.venv

# PyCharm / IntelliJ
.idea/

# VS Code
.vscode/

# Testing
.coverage
htmlcov/
coverage.xml

# Keep test fixtures
!tests/fixtures/
!tests/fixtures/*.html
!tests/fixtures/*.pdf
!tests/fixtures/*.md

# Environment variables
.env
.env.*
!.env.example

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# CSV files
*.csv

# Log files
*.log

# OS specific
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Data directory — ignore everything except whitelisted paths
data/*
data/pdfs/*
!data/pdfs/
!data/pdfs/*.pdf
!data/vectors/
!data/vectors/*
!data/free_float.db
output/

# Docker
.dockerignore

# Temporary files
tmp/
temp/
