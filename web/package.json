{
  "name": "csd-web",
  "displayName": "CSD Free Float",
  "version": "1.0.0",
  "private": true,
  "description": "CSD-BG Free Float web client (Angular + Cordova browser)",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/write-locale-index.mjs",
    "build:web": "npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "clean": "rm -rf www",
    "cordova:run": "cordova run browser",
    "cordova:build": "cordova build browser",
    "cordova:prepare": "cordova prepare browser"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "apache-arrow": "^21.2.0",
    "echarts": "^6.1.0",
    "lz4js": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "cordova-browser": "^7.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "cordova": {
    "platforms": ["browser"]
  }
}
