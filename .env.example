# .env.example
# Copy this file to .env and customize as needed

# Docker volume and user (for Synology production)
DATA_HOST_PATH=/volume2/docker/csd-bg/data
DOCKER_USER=1031:65538

# Python environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Application settings
APP_TIMEOUT=30
# Full URL of the member statistics page (GET + POST pagination). Set in production .env only.
CSD_BG_STATISTICS_URL=https://your-host.example/members/memberStatistics.xhtml

# Node.js (default runtime)
NODE_ENV=production

# Paths (for production)
CSV_PATH=/data/free_float.csv
DB_PATH=/data/free_float.db
# PDF_DIR=/data/pdfs

# Timezone
TZ=Europe/Sofia

# Logging (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=INFO
