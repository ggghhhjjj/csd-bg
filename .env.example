# .env.example
# Copy this file to .env and customize as needed

# Docker volume and user (for Synology production)
DATA_HOST_PATH=/volume2/docker/test
DOCKER_USER=1031:65538

# Python environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Application settings
APP_TIMEOUT=30

# Paths (for production)
CSV_PATH=/data/free_float.csv
DB_PATH=/data/free_float.db

# Timezone
TZ=Europe/Sofia

# Logging
LOG_LEVEL=INFO
